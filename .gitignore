# 本机 Python 虚拟环境与 pytest 缓存不应提交到仓库。
.venv/
.pytest_cache/
__pycache__/
*.py[cod]

# 每次运行生成的 HTML、截图、录像、登录态和临时人工验证状态均为产物，不提交历史文件。
artifacts/

# 本机 IDE 和系统文件。
.idea/
.DS_Store

# 飞书授权流程生成的本地二维码，不属于测试工程，也不得提交到远程仓库。
lark-*.png

# 安全扫描钩子的本机会话状态与源码快照（.source 是仓库文件的副本），
# 按 session id 生成、不可复用，属于本机工具产物。
.mimosa/

# 飞书扫码登录保存的本地会话，含身份凭据，绝不提交。
.lark-session/

# 会员/Premium 登录调试用的持久化 Chrome profile，含登录凭据，绝不提交。
.membership-session/
.premium-session/

# ZCode 本机会话与工具状态，不属于测试工程。
.zcode/
